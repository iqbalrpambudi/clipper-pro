<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cliperpro.shorts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd /Users/iqbalpambudi/Project/cliper-pro/automation/youtube &amp;&amp; /opt/homebrew/bin/claude -p "$(cat DAILY.md)" --allowedTools "Bash(uv run shorts.py:*)" "Bash(rtk uv run shorts.py:*)" "Read" &gt;&gt; run.log 2&gt;&amp;1</string>
  </array>
  <!-- 01:00 local (WIB): both videos are ready before the 07:00 slot -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>0</integer></dict>
</dict>
</plist>
