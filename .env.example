# Application Ports
WEB_PORT=3030
API_PORT=8080

# Database (SQLite file)
DATABASE_URL=sqlite+aiosqlite:///storage/cliper.db

# Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=2147483648
MAX_SOURCE_DURATION_MINS=30

# CORS & Web
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Encryption Key for sensitive DB fields (Fernet requires 32 url-safe base64-encoded bytes)
# Example generated with cryptography.fernet.Fernet.generate_key()
ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS1mb3ItZGI=

# Default AI Settings (can be overridden via UI Settings)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_CHAT_MODEL=gemini-2.0-flash
AI_VISION_MODEL=gemini-2.0-flash
TTS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck
