# Salin ke .env untuk development dari source (make dev). Mode service
# (`cliper-pro start`) menyimpan data di ~/.cliper-pro/ dan tidak butuh file ini.

# Data & Database (SQLite)
# CLIPER_DATA_DIR=~/.cliper-pro
DATABASE_URL=sqlite+aiosqlite:///storage/cliper.db
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=2147483648
MAX_SOURCE_DURATION_MINS=60

# CORS & Web
CORS_ORIGINS=http://localhost:3031,http://127.0.0.1:18080,http://localhost:18080
# Origin API yang bisa dijangkau browser (dipakai untuk redirect URI OAuth YouTube)
PUBLIC_API_URL=http://127.0.0.1:18080
# Vite dev server (apps/web)
VITE_API_URL=
VITE_PROXY_TARGET=http://127.0.0.1:18080

# Kunci enkripsi field sensitif di DB (Fernet: 32 byte base64 url-safe).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Jangan diganti setelah ada data, secret lama tidak bisa dibuka.
# ENCRYPTION_KEY=

# AI default (bisa di-override lewat halaman Settings di Web UI)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_CHAT_MODEL=gemini-2.0-flash
AI_VISION_MODEL=gemini-2.0-flash

# Text-to-Speech: gemini | elevenlabs
TTS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TTS_VOICE=Puck
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
